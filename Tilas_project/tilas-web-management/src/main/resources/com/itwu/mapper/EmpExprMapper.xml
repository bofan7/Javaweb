<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    namespace 需要绑定到你对应的 Dao/Mapper 接口的全限定名
    例如：com.example.dao.EmpMapper
-->

<!--
    mapper.xml 必须放在 src/main/resources/com.itwu.mapper 目录下
    这样才能程序才能把 mapper.xml 文件识别到mapper.java
-->
<mapper namespace="com.itwu.mapper.EmpExprMapper">

    <!-- 在这里写 SQL -->


    <!--使用了动态sql-->

<!--


-->
    <insert id="insertBatch">
        insert into emp_expr(emp_id,begin,end,company,job) values
        <foreach collection="list" item="i" separator=",">
            (#{i.empId},#{i.begin},#{i.end},#{i.company},#{i.job})
        </foreach>
    </insert>

    <!--
    根据员工ID批量删除员工工作经历
    -->
    <delete id="deleteByEmpIds">
        delete from emp_expr where emp_id in
        <foreach collection="empIds" item="empId" separator="," open="(" close=")">
            #{empId}
        </foreach>
    </delete>
</mapper>